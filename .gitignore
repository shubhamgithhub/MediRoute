
# ==================================
# MediRoute Git Ignore Rules
# ==================================

# Python generated files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Python testing / IDE cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VS Code local workspace settings
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Local logs
*.log

# Temporary files
*.tmp

# Sensitive patient documents
Data/patient_uploads/
Data/private_reports/
