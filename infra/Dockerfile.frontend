# Template only: pin reviewed base image by digest for final CI.
FROM nginx:stable-alpine3.24
RUN apk add --no-cache --upgrade 'zlib>=1.4-r0' 'libxslt>=1.1.43-r4' curl
COPY infra/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx/duckdns.conf /etc/nginx/mediroute-duckdns.conf
COPY --chmod=755 infra/nginx/40-mediroute-duckdns.sh /docker-entrypoint.d/40-mediroute-duckdns.sh
COPY frontend/ /usr/share/nginx/html/
EXPOSE 8080
