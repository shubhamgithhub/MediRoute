{
  "family": "mediroute-demo",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "cpu": "${TASK_CPU}",
  "memory": "${TASK_MEMORY}",
  "executionRoleArn": "${TASK_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "${BACKEND_IMAGE}",
      "essential": true,
      "environment": [
        {"name": "MEDIROUTE_HOST", "value": "0.0.0.0"},
        {"name": "MEDIROUTE_PORT", "value": "8000"},
        {"name": "MEDIROUTE_LLM_PROVIDER", "value": "openrouter"},
        {"name": "MEDIROUTE_OPENROUTER_MODEL", "value": "openai/gpt-6-luna"}
      ],
      "secrets": [
        {
          "name": "OPENROUTER_API_KEY",
          "valueFrom": "${OPENROUTER_API_KEY_PARAMETER_ARN}"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c 'import urllib.request; urllib.request.urlopen(\"http://127.0.0.1:8000/api/health\",timeout=5)'"],
        "interval": 30,
        "timeout": 8,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {"awslogs-group": "${LOG_GROUP}", "awslogs-region": "${AWS_REGION}", "awslogs-stream-prefix": "api"}
      }
    },
    {
      "name": "frontend",
      "image": "${FRONTEND_IMAGE}",
      "essential": true,
      "dependsOn": [{"containerName": "api", "condition": "HEALTHY"}],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {"awslogs-group": "${LOG_GROUP}", "awslogs-region": "${AWS_REGION}", "awslogs-stream-prefix": "frontend"}
      }
    },
    {
      "name": "tunnel",
      "image": "${CLOUDFLARED_IMAGE}",
      "essential": true,
      "dependsOn": [{"containerName": "frontend", "condition": "START"}],
      "command": ["tunnel", "--url", "http://127.0.0.1:8080"],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {"awslogs-group": "${LOG_GROUP}", "awslogs-region": "${AWS_REGION}", "awslogs-stream-prefix": "tunnel"}
      }
    }
  ]
}
