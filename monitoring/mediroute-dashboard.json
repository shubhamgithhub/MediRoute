  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 4,
      "properties": {
        "markdown": "# MediRoute — on-demand demo\nManaged by `monitoring/build_dashboard.py`. Region: Sydney. Seven custom metric series, fixed `Environment=dev`. No Container Insights, alarms, paid probes, or log-query widgets.\n\nGraphs appear only after the instrumented backend is deployed and used. Blank means no observations, not zero traffic or zero spending. Stop the task after the demonstration."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 4,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Recommendation requests / hour",
        "region": "ap-southeast-2",
        "view": "timeSeries",
        "period": 3600,
        "metrics": [
          [
            "MediRoute/Demo",
            "Queries",
            "Environment",
            "dev",
            {
              "id": "q",
              "stat": "Sum",
              "visible": true
            }
          ]
        ],
        "stacked": false
      }
    },
