              "visible": true
            }
          ]
        ],
        "period": 300,
        "view": "singleValue",
        "stacked": false,
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 20,
      "y": 33,
      "width": 4,
      "height": 4,
      "properties": {
        "title": "Rejected",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "MediRoute/Demo",
            "QueriesRejected",
            "Environment",
            "dev",
            {
              "id": "rejected",
              "stat": "Sum",
              "label": "HTTP 4xx",
              "color": "#5f6b7a",
              "visible": true
            }
          ]
        ],
        "period": 300,
        "view": "singleValue",
        "stacked": false,
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 37,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Daily queries, failures, retries and rejections",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "MediRoute/Demo",
            "Queries",
            "Environment",
            "dev",
            {
              "id": "q",
              "stat": "Sum",
              "label": "Queries",
              "color": "#1769e0",
              "visible": true
            }
          ],
          [
            "MediRoute/Demo",
            "QueriesFailed",
            "Environment",
            "dev",
            {
              "id": "f",
              "stat": "Sum",
              "label": "Failed",
              "color": "#b62337",
              "visible": true
            }
          ],
          [
            "MediRoute/Demo",
            "QueriesRetried",
            "Environment",
            "dev",
            {
              "id": "r",
              "stat": "Sum",
              "label": "Retried",
              "color": "#a84f00",
              "visible": true
            }
          ],
          [
            "MediRoute/Demo",
            "QueriesRejected",
            "Environment",
            "dev",
            {
              "id": "rejected",
              "stat": "Sum",
              "label": "Rejected",
              "color": "#5f6b7a",
              "visible": true
            }
          ],
          [
            {
              "expression": "IF(q>0,100*f/q)",
              "id": "error_rate",
              "label": "Server error rate (%)",
              "color": "#7052be",
              "yAxis": "right"
            }
          ]
        ],
        "period": 86400,
        "view": "timeSeries",
        "stacked": false,
        "yAxis": {
          "right": {
            "min": 0,
            "max": 100,
            "showUnits": false
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 37,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Daily query latency · average, p50, p95 (ms)",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "MediRoute/Demo",
            "QueryTimeMs",
            "Environment",
            "dev",
            {
              "id": "avg",
              "stat": "Average",
              "label": "Average",
