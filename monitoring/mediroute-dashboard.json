          [
            "MediRoute/Demo",
            "QueriesFailed",
            "Environment",
            "dev",
            {
              "id": "f",
              "stat": "Sum",
              "label": "Server failures",
              "color": "#b62337",
              "visible": true
            }
          ]
        ],
        "period": 300,
        "view": "singleValue",
        "stacked": false,
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 33,
      "width": 4,
      "height": 4,
