      "y": 50,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Daily LLM calls and failed attempts",
        "region": "ap-southeast-2",
        "metrics": [
          [
            "MediRoute/Demo",
            "LLMCalls",
            "Environment",
            "dev",
            {
              "id": "calls",
