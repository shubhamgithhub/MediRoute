            {
              "id": "samples",
              "stat": "SampleCount",
              "label": "Costs reported",
              "color": "#1769e0",
              "visible": false
            }
          ],
          [
            {
              "expression": "IF(calls>0,100*samples/calls)",
              "id": "coverage",
              "label": "Cost reporting (%)",
              "color": "#007c78",
              "yAxis": "right"
            }
          ]
        ],
