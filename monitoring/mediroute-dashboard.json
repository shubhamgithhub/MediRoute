            "dev",
            {
              "id": "cost",
              "stat": "Sum",
              "label": "Known daily cost",
              "color": "#1769e0",
              "visible": true
            }
          ],
          [
            "MediRoute/Demo",
            "Queries",
            "Environment",
            "dev",
            {
              "id": "q",
              "stat": "Sum",
              "label": "Queries",
              "color": "#1769e0",
              "visible": false
            }
          ],
          [
            "MediRoute/Demo",
            "LLMCalls",
            "Environment",
            "dev",
            {
              "id": "calls",
              "stat": "Sum",
